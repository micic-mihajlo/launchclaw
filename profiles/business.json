{
  "name": "business",
  "description": "Professional setup with allowlist-based access and business hours",
  "channels": ["slack", "discord"],
  "maxConcurrentAgents": 4,
  "maxSubAgents": 0,
  "model": "anthropic/claude-sonnet-4-5",
  "heartbeatInterval": 15,
  "heartbeatSchedule": "business_hours",
  "compaction": "safeguard",
  "accessPolicy": "allowlist",
  "features": {
    "webTools": false,
    "githubIntegration": false,
    "subAgents": false
  }
}
