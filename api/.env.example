# API server
PORT=8787
# Optional bearer auth for this API itself.
# If set, send: Authorization: Bearer <LAUNCHCLAW_API_TOKEN>
LAUNCHCLAW_API_TOKEN=

# SQLite path for order/provisioning state.
LAUNCHCLAW_DB_PATH=./data/launchclaw.db

# Hetzner credentials
HETZNER_API_TOKEN=

# Optional defaults for server creation
HETZNER_DEFAULT_IMAGE=ubuntu-24.04
HETZNER_DEFAULT_SERVER_TYPE=cpx21
HETZNER_DEFAULT_LOCATION=nbg1
# Comma-separated ssh key ids or names (e.g. 12345,work-laptop)
HETZNER_DEFAULT_SSH_KEYS=

# LaunchClaw defaults
DEFAULT_PROFILE=business
DEFAULT_MODEL=anthropic/claude-sonnet-4-5
DEFAULT_AGENT_NAME=Assistant
DEFAULT_CHANNELS=discord
DEFAULT_GATEWAY_PORT=18789

# Auto-provision order as soon as webhook/mark-paid marks it paid.
AUTO_PROVISION_PAID_ORDERS=true

# Optional webhook signing secret.
# If set, /v1/webhooks/orders expects x-launchclaw-signature (HMAC SHA256 hex or sha256=<hex>)
ORDER_WEBHOOK_SECRET=

# Optional Cloudflare DNS automation for domain records.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PROXIED=false
CLOUDFLARE_TTL=120
CLOUDFLARE_CREATE_AAAA=false
